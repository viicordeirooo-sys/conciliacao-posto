rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Regras do Firestore — app de conciliação de posto único (conciliacao/posto1).
//
// Histórico de versões:
//   v1 — open: acesso liberado (sem autenticação).            [legado]
//   v2 — auth-wildcard: allow read, write: if request.auth != null
//        (qualquer usuário autenticado lia/escrevia).          [anterior]
//   v3 — RBAC (esta): acesso só para usuários com custom claim
//        role == "admin" ou role == "partner". Ambos os papéis
//        têm acesso total (read/write/delete). Sem role válido → negado.
//
// Modelo de papéis:
//   - "admin"   → acesso total à coleção `conciliacao`.
//   - "partner" → acesso total à coleção `conciliacao` (mesmo nível do admin).
//   - qualquer outro / sem claim → negado.
//   Claims são definidos fora do app, via set-claims.mjs (Firebase Admin SDK).
//
// Publicação: estas rules são publicadas via Firebase CLI, NÃO pelo Console.
//   firebase.json mapeia "firestore.rules" → publicar com:
//   firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers de papel (RBAC) ──────────────────────────────────────────────
    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }
    function isAdmin()   { return role() == "admin"; }
    function isPartner() { return role() == "partner"; }

    // ─── Validação de ENVELOPE (defesa em profundidade, v5) ──────────────────────
    // Validam só a FORMA do topo do doc: chaves permitidas (hasOnly), chaves
    // obrigatórias (hasAll), tipos (is list / is map) e um teto de tamanho nos
    // arrays. NÃO validam o conteúdo de cada item dos arrays — Rules não iteram
    // listas de tamanho arbitrário; a validação por-registro continua no cliente
    // (normSale/normBank). Recebem `d` = request.resource.data.
    //
    // PREMISSA: toda gravação envia o doc INTEIRO (tx.set), nunca update parcial
    // de campo isolado. O hasAll depende disso. Se algum dia entrar updateDoc/merge
    // parcial de um campo só, estas funções QUEBRAM (hasAll falha) — revisar antes.

    // Doc LEGADO (posto1): topo = {sales, bank, mdr, config}. Os 4 obrigatórios.
    function isValidLegacyDoc(d) {
      return d.keys().hasOnly(['sales','bank','mdr','config'])
        && d.keys().hasAll(['sales','bank','mdr','config'])
        && d.sales is list && d.sales.size() <= 10000
        && d.bank  is list && d.bank.size()  <= 10000
        && d.mdr    is map
        && d.config is map;
    }

    // Doc MÊS (posto1_m_YYYY-MM): topo = SÓ {sales, bank}. Sem mdr/config.
    function isValidMonthDoc(d) {
      return d.keys().hasOnly(['sales','bank'])
        && d.keys().hasAll(['sales','bank'])
        && d.sales is list && d.sales.size() <= 10000
        && d.bank  is list && d.bank.size()  <= 10000;
    }

    // Doc META (posto1_meta): topo = {config, mdr, months} + schemaVersion OPCIONAL.
    // Backfill (Fase 4) grava SEM schemaVersion; cutover (Fase 5) grava COM. Por isso
    // schemaVersion entra no hasOnly mas NÃO no hasAll. Se presente, exigimos que seja
    // número (int OU float — Rules não tem `is number`).
    function isValidMeta(d) {
      return d.keys().hasOnly(['config','mdr','months','schemaVersion'])
        && d.keys().hasAll(['config','mdr','months'])
        && d.config is map
        && d.mdr    is map
        && d.months is list && d.months.size() <= 240
        && ( !('schemaVersion' in d.keys())
             || d.schemaVersion is int || d.schemaVersion is float );
    }

    // Dados do app na coleção 'conciliacao'. Hardening (v4): além do RBAC,
    // o docId precisa ser um id LEGÍTIMO (defesa em profundidade — impede que
    // uma conta autorizada crie/leia docs arbitrários na coleção).
    //   posto1            → doc legado (single-doc; mantido p/ rollback)
    //   posto1_meta       → config/mdr + índice de meses (modelo paginado)
    //   posto1_m_YYYY-MM  → dados de um mês (sales+bank)
    // RBAC inalterado vs v3: acesso total só admin OU partner; o matches() só
    // restringe QUAIS docIds passam, não QUEM pode ler/escrever.
    match /conciliacao/{docId} {
      // QUEM pode (RBAC, inalterado vs v3/v4) e QUAIS docIds são legítimos (v4).
      function authed()     { return isAdmin() || isPartner(); }
      function validDocId() { return docId.matches('^posto1(_meta|_m_[0-9]{4}-[0-9]{2})?$'); }

      // Roteia o validador de envelope pela FORMA do docId. Definida aqui dentro
      // porque referencia `docId`. Qualquer docId fora das 3 formas → false (mas o
      // validDocId() já barraria antes; isto é só fail-safe).
      function envelopeOk() {
        return docId == 'posto1'      ? isValidLegacyDoc(request.resource.data)
             : docId == 'posto1_meta' ? isValidMeta(request.resource.data)
             : docId.matches('^posto1_m_[0-9]{4}-[0-9]{2}$')
                                       ? isValidMonthDoc(request.resource.data)
             : false;
      }

      // read e delete: INALTERADOS (RBAC + docId legítimo; sem request.resource.data
      // no delete, então não há envelope a validar).
      allow read:   if authed() && validDocId();
      allow delete: if authed() && validDocId();

      // create e update: além de tudo acima, o envelope do payload precisa bater
      // com a forma do doc (chaves/tipos/tamanho do topo).
      allow create, update: if authed() && validDocId() && envelopeOk();
    }

    // Trilha de auditoria (Nível 1) — append-only DE VERDADE: cria-se, nunca se
    // edita/apaga (nem admin). Leitura só admin. ts travado em request.time
    // (serverTimestamp) impede backdating; uid travado em request.auth.uid impede
    // forjar identidade de outro usuário. hasOnly = só envelope (sem validar summary).
    match /audit_log/{logId} {
      allow create: if (isAdmin() || isPartner())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.keys().hasOnly(['ts','action','target','uid','email','role','summary']);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Qualquer outra coleção é negada por padrão (default-deny explícito).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
