rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Regras do Firestore — app de conciliação de posto (coleção `conciliacao`).
//
// Histórico de versões:
//   v1 — open: acesso liberado (sem autenticação).            [legado]
//   v2 — auth-wildcard: allow read, write: if request.auth != null
//        (qualquer usuário autenticado lia/escrevia).          [anterior]
//   v3 — RBAC: acesso só para usuários com custom claim role == "admin"
//        ou "partner". Ambos com acesso total. Sem role válido → negado.
//   v4 — validDocId: só docIds legítimos (posto1 / _meta / _m_).
//   v5 — envelope: valida forma do topo de cada doc (hasOnly/hasAll/tipos).
//   v6 — paginação DIÁRIA + multi-posto: docId genérico posto[0-9]+
//        (aceita posto1, posto2, …); novo doc-dia postoN_d_YYYY-MM-DD com
//        isValidDayDoc; meta passa a indexar DIAS (isValidMeta {config,mdr,days},
//        teto 4000); doc-mês (_m_) MANTIDO só durante a transição mês→dia.
//   v7 — multi-posto DE VERDADE (esta): novo doc postos_registry {postos:[{id,nome}]}
//        (isValidRegistry, teto 50) — índice dos postos do dono. Migração mês→dia
//        concluída → doc-mês (_m_) e isValidMonthDoc REMOVIDOS do validDocId/envelope.
//        RBAC e audit_log intocados.
//
// Modelo de papéis:
//   - "admin"   → acesso total à coleção `conciliacao`.
//   - "partner" → acesso total à coleção `conciliacao` (mesmo nível do admin).
//   - qualquer outro / sem claim → negado.
//   Claims são definidos fora do app, via set-claims.mjs (Firebase Admin SDK).
//
// Publicação: estas rules são publicadas via Firebase CLI, NÃO pelo Console.
//   firebase.json mapeia "firestore.rules" → publicar com:
//   firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers de papel (RBAC) ──────────────────────────────────────────────
    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }
    function isAdmin()   { return role() == "admin"; }
    function isPartner() { return role() == "partner"; }

    // ─── Validação de ENVELOPE (defesa em profundidade, v5) ──────────────────────
    // Validam só a FORMA do topo do doc: chaves permitidas (hasOnly), chaves
    // obrigatórias (hasAll), tipos (is list / is map) e um teto de tamanho nos
    // arrays. NÃO validam o conteúdo de cada item dos arrays — Rules não iteram
    // listas de tamanho arbitrário; a validação por-registro continua no cliente
    // (normSale/normBank). Recebem `d` = request.resource.data.
    //
    // PREMISSA: toda gravação envia o doc INTEIRO (tx.set), nunca update parcial
    // de campo isolado. O hasAll depende disso. Se algum dia entrar updateDoc/merge
    // parcial de um campo só, estas funções QUEBRAM (hasAll falha) — revisar antes.

    // Doc LEGADO (posto1): topo = {sales, bank, mdr, config}. Os 4 obrigatórios.
    function isValidLegacyDoc(d) {
      return d.keys().hasOnly(['sales','bank','mdr','config'])
        && d.keys().hasAll(['sales','bank','mdr','config'])
        && d.sales is list && d.sales.size() <= 10000
        && d.bank  is list && d.bank.size()  <= 10000
        && d.mdr    is map
        && d.config is map;
    }

    // Doc DIA (postoN_d_YYYY-MM-DD): topo = SÓ {sales, bank}.
    // Um dia real tem ~768 registros; teto 10000 é folga sã contra payload absurdo.
    function isValidDayDoc(d) {
      return d.keys().hasOnly(['sales','bank'])
        && d.keys().hasAll(['sales','bank'])
        && d.sales is list && d.sales.size() <= 10000
        && d.bank  is list && d.bank.size()  <= 10000;
    }

    // Doc META (postoN_meta): topo = {config, mdr, days} + schemaVersion OPCIONAL.
    // O índice agora é por DIA (days:[{dia,salesCount,bankCount}]). schemaVersion entra
    // no hasOnly mas NÃO no hasAll (backfill grava sem; save/migração gravam com). Se
    // presente, exigimos número (int OU float — Rules não tem `is number`). Teto 4000
    // dias (~15 anos de operação) — o antigo 240 cobria só ~<1 ano de meses.
    function isValidMeta(d) {
      return d.keys().hasOnly(['config','mdr','days','schemaVersion'])
        && d.keys().hasAll(['config','mdr','days'])
        && d.config is map
        && d.mdr    is map
        && d.days is list && d.days.size() <= 4000
        && ( !('schemaVersion' in d.keys())
             || d.schemaVersion is int || d.schemaVersion is float );
    }

    // Doc REGISTRY (postos_registry): topo = SÓ {postos}. Índice dos postos do dono:
    // postos:[{id,nome}]. Teto 50 postos. Como Rules não iteram listas, o shape de
    // cada item ({id,nome} com id casando ^posto[0-9]+$) é validado NO CLIENTE
    // (createPosto/bootstrap) — aqui validamos só o envelope (list + tamanho).
    function isValidRegistry(d) {
      return d.keys().hasOnly(['postos'])
        && d.keys().hasAll(['postos'])
        && d.postos is list && d.postos.size() <= 50;
    }

    // Dados do app na coleção 'conciliacao'. Hardening (v4): além do RBAC,
    // o docId precisa ser um id LEGÍTIMO (defesa em profundidade — impede que
    // uma conta autorizada crie/leia docs arbitrários na coleção).
    //   postos_registry      → índice dos postos do dono {postos:[{id,nome}]}
    //   postoN               → doc legado (single-doc; órfão pós-migração)
    //   postoN_meta          → config/mdr + índice de DIAS (modelo paginado diário)
    //   postoN_d_YYYY-MM-DD  → dados de um DIA (sales+bank)  [modelo atual]
    // MULTI-POSTO: docId genérico posto[0-9]+ (posto1, posto2, …) + o doc singular
    // postos_registry. O doc-mês (_m_) saiu — migração mês→dia concluída, nenhum
    // posto novo passa por ele. RBAC inalterado vs v3: acesso total só admin OU partner.
    match /conciliacao/{docId} {
      // QUEM pode (RBAC, inalterado) e QUAIS docIds são legítimos (multi-posto).
      function authed()     { return isAdmin() || isPartner(); }
      function validDocId() {
        return docId == 'postos_registry'
            || docId.matches('^posto[0-9]+(_meta|_d_[0-9]{4}-[0-9]{2}-[0-9]{2})?$');
      }

      // Roteia o validador de envelope pela FORMA do docId. Definida aqui dentro
      // porque referencia `docId`. Qualquer docId fora das formas → false (mas o
      // validDocId() já barraria antes; isto é só fail-safe).
      function envelopeOk() {
        return docId == 'postos_registry'                                  ? isValidRegistry(request.resource.data)
             : docId.matches('^posto[0-9]+$')                              ? isValidLegacyDoc(request.resource.data)
             : docId.matches('^posto[0-9]+_meta$')                         ? isValidMeta(request.resource.data)
             : docId.matches('^posto[0-9]+_d_[0-9]{4}-[0-9]{2}-[0-9]{2}$') ? isValidDayDoc(request.resource.data)
             : false;
      }

      // read e delete: INALTERADOS (RBAC + docId legítimo; sem request.resource.data
      // no delete, então não há envelope a validar).
      allow read:   if authed() && validDocId();
      allow delete: if authed() && validDocId();

      // create e update: além de tudo acima, o envelope do payload precisa bater
      // com a forma do doc (chaves/tipos/tamanho do topo).
      allow create, update: if authed() && validDocId() && envelopeOk();
    }

    // Trilha de auditoria (Nível 1) — append-only DE VERDADE: cria-se, nunca se
    // edita/apaga (nem admin). Leitura só admin. ts travado em request.time
    // (serverTimestamp) impede backdating; uid travado em request.auth.uid impede
    // forjar identidade de outro usuário. hasOnly = só envelope (sem validar summary).
    match /audit_log/{logId} {
      allow create: if (isAdmin() || isPartner())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.keys().hasOnly(['ts','action','target','uid','email','role','summary']);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Qualquer outra coleção é negada por padrão (default-deny explícito).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
